# Скопируйте в .env и заполните. Файл .env не публикуйте и храните копию отдельно от сервера.
# Сгенерировать значения: openssl rand -hex 32
POSTGRES_USER=serviceaudit
POSTGRES_PASSWORD=СМЕНИТЕ_НА_СЛУЧАЙНОЕ
POSTGRES_DB=serviceaudit
N8N_ENCRYPTION_KEY=СМЕНИТЕ_НА_СЛУЧАЙНОЕ_И_НЕ_МЕНЯЙТЕ
HOST=audit.example-service.ru
TZ=Europe/Moscow
TUNNEL_TOKEN=ВСТАВЬТЕ_ТОКЕН_ТУННЕЛЯ_CLOUDFLARE
# Ключ шифрования фото AES-256: ровно 64 символа hex (openssl rand -hex 32). Потеряете ключ, фото в архиве не расшифровать.
ARCHIVE_KEY_HEX=СМЕНИТЕ_НА_64_СИМВОЛА_HEX
ADMIN_CHAT_ID=0
# Vision-модель Ollama (пример, не проверялась на мелких серийных номерах): подберите по железу
OLLAMA_VISION_MODEL=qwen2.5vl:7b
